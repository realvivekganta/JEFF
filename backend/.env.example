# JEFF configuration. Copy to .env and supply your own credentials.
PORT=3100
VOICE_PORT=3101
# Required for the voice agent and dashboard conversation.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna
# Exact HTTPS origin of ngrok forwarding to VOICE_PORT, no trailing slash.
PUBLIC_BASE_URL=
# Used by the README's ngrok launcher; not sent to the frontend.
NGROK_AUTHTOKEN=
TWILIO_AUTH_TOKEN=
# Your personal test cell number, not the purchased Twilio number.
DEMO_CALLER_NUMBER=
